# Copy this file to .env and adjust for your server.

# Port the web backend listens on (browser UI connects here)
PORT=8080

# Root directory under which each named workspace gets its own subfolder +
# its own independent Aider session. Created automatically if missing.
WORKSPACES_ROOT=/srv/aider-workspaces

# Path/command used to launch Aider. Usually just "aider" if it's on PATH.
AIDER_BIN=aider

# Ollama server base URL (used for health/model listing and passed to Aider
# as OLLAMA_API_BASE so it talks to the same place)
OLLAMA_API_BASE=http://127.0.0.1:11434

# Default model (Aider convention: prefix with ollama/ for Ollama models)
DEFAULT_MODEL=ollama/qwen2.5-coder:32b

# Default chat mode: ask | code | architect
DEFAULT_MODE=code

# Max upload size in MB
MAX_UPLOAD_MB=50

# Optional shared-secret. If set, the UI must send it as
# `Authorization: Bearer <token>` on REST calls and `?token=<token>` on the
# WebSocket. Leave blank to disable (fine for a trusted LAN).
ACCESS_TOKEN=
